Перем _Синоним;

// Возвращает имя аннотации
//
// Возвращаемое значение:
//   Строка - имя аннотации
//
Функция ИмяАннотации() Экспорт
	Возврат "Синоним";
КонецФункции

// Возвращает синоним (альтернативное имя ключа в конфигурации)
//
// Возвращаемое значение:
//   Строка - синоним свойства
//
Функция Синоним() Экспорт
	Возврат _Синоним;
КонецФункции

&Аннотация("Синоним")
Процедура ПриСозданииОбъекта(Значение) Экспорт
	_Синоним = Значение;
КонецПроцедуры
