// Описание одного поля DTO-класса, полученное из аннотаций свойства

Перем Имя Экспорт;                // Строка - имя свойства класса
Перем Тип Экспорт;                // Тип - целевой тип значения из аннотации Тип
Перем ЗначениеПоУмолчанию Экспорт; // Произвольный - значение по умолчанию
Перем Синоним Экспорт;            // Строка - альтернативное имя ключа в конфигурации
Перем Обязательное Экспорт;       // Булево - признак обязательности (нет ЗначениеПоУмолчанию)
Перем ОписанияВложенныхПолей Экспорт; // Массив из ОписаниеПоляДТО - описания полей вложенного DTO

// Конструктор описания поля
//
// Параметры:
//   ИмяПоля - Строка - имя свойства класса
//
Процедура ПриСозданииОбъекта(Знач ИмяПоля)

	Имя = ИмяПоля;
	Тип = Неопределено;
	ЗначениеПоУмолчанию = Неопределено;
	Синоним = Неопределено;
	Обязательное = Истина;
	ОписанияВложенныхПолей = Неопределено;

КонецПроцедуры

// Устанавливает значение по умолчанию, делая поле необязательным
//
// Параметры:
//   Значение - Произвольный - значение по умолчанию
//
Процедура УстановитьЗначениеПоУмолчанию(Знач Значение) Экспорт

	ЗначениеПоУмолчанию = Значение;
	Обязательное = Ложь;

КонецПроцедуры

// Устанавливает тип значения явно (из аннотации &Тип)
//
// Параметры:
//   НовыйТип - Тип - целевой тип значения
//
Процедура УстановитьТип(Знач НовыйТип) Экспорт
	Тип = НовыйТип;
КонецПроцедуры

// Устанавливает синоним поля
//
// Параметры:
//   НовыйСиноним - Строка - альтернативное имя ключа в конфигурации
//
Процедура УстановитьСиноним(Знач НовыйСиноним) Экспорт
	Синоним = НовыйСиноним;
КонецПроцедуры

// Помечает поле как вложенный DTO и сохраняет описания его полей
//
// Параметры:
//   ОписанияПолей - Массив из ОписаниеПоляДТО - описания полей вложенного DTO
//
Процедура УстановитьВложенныйДТО(Знач ОписанияПолей) Экспорт
	ОписанияВложенныхПолей = ОписанияПолей;
КонецПроцедуры

// Возвращает признак того, что поле является вложенным DTO
//
// Возвращаемое значение:
//   Булево - Истина, если поле описано как вложенный DTO
//
Функция ЭтоВложенныйДТО() Экспорт
	Возврат Не ОписанияВложенныхПолей = Неопределено;
КонецФункции

// Возвращает ключ для поиска в конфигурации
// Если задан синоним - возвращает его, иначе - имя свойства
//
// Возвращаемое значение:
//   Строка - ключ для поиска в конфигурации
//
Функция КлючКонфигурации() Экспорт

	Если Не Синоним = Неопределено Тогда
		Возврат Синоним;
	КонецЕсли;

	Возврат Имя;

КонецФункции
