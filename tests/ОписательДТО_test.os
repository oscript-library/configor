// Нераспознанная строка для булево вызывает исключение
Процедура ТестДолжен_ВыброситьИсключениеПриНевалидномБулево() Экспорт

	ДТО = ЗагрузитьДТО("ТестовыйДТОСТипами.os");

	ВременныйФайл = ПолучитьВременныйФайлJSON(
		"{""cfg"": {""Порт"": ""1"", ""Включен"": ""maybe"", ""Название"": ""test"", ""ДатаЗапуска"": ""2025-01-01T00:00:00""}}"
	);

	Менеджер = Новый МенеджерПараметров;
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровJSON())
		.Настройки()
		.УстановитьФайлПараметров(ВременныйФайл);
	Менеджер.ЗарегистрироватьКлассПараметров(ДТО, "cfg");
	Менеджер.Прочитать();

	Попытка
		Менеджер.ЗаполнитьОбъектПараметров(ДТО);
		Ожидаем.Что(Ложь, "Ожидалось исключение для невалидного булева значения").Равно(Истина);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Включен");
	КонецПопытки;

	УдалитьФайлы(ВременныйФайл);

	// перечисление нескольких допустимых значений через запятую не является допустимым значением
	ДТО = ЗагрузитьДТО("ТестовыйДТОСТипами.os");

	ВременныйФайл = ПолучитьВременныйФайлJSON(
		"{""cfg"": {""Порт"": ""1"", ""Включен"": ""1,TRUE"", ""Название"": ""t"", ""ДатаЗапуска"": ""2025-01-01T00:00:00""}}"
	);

	Менеджер = Новый МенеджерПараметров;
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровJSON())
		.Настройки()
		.УстановитьФайлПараметров(ВременныйФайл);
	Менеджер.ЗарегистрироватьКлассПараметров(ДТО, "cfg");
	Менеджер.Прочитать();

	Попытка
		Менеджер.ЗаполнитьОбъектПараметров(ДТО);
		Ожидаем.Что(Ложь, "Ожидалось исключение для значения ""1,TRUE""").Равно(Истина);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Включен");
	КонецПопытки;

	УдалитьФайлы(ВременныйФайл);

КонецПроцедуры

