// Трёхуровневый DTO - Приложение.БазаДанных.Подключение
Процедура ТестДолжен_ЗаполнитьДвухуровневыйДТО() Экспорт

	// Arrange
	ДТО = ЗагрузитьДТО("ТестовыйДТОПриложение.os");
	ВременныйФайл = ПолучитьВременныйФайлJSON(
		"{""Приложение"": {""Название"": ""SuperApp"", ""Версия"": ""2.0.0"", ""БазаДанных"": {""ИмяБазы"": ""prod_db"", ""Подключение"": {""Хост"": ""prod-host"", ""Порт"": 5432}}}}"
	);

	Менеджер = Новый МенеджерПараметров;
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровJSON())
		.Настройки()
		.УстановитьФайлПараметров(ВременныйФайл);
	Менеджер.ЗарегистрироватьКлассПараметров(ДТО, "Приложение");

	// Act
	Менеджер.Прочитать();
	Менеджер.ЗаполнитьОбъектПараметров(ДТО);

	// Assert
	Ожидаем.Что(ДТО.Название, "Название должно быть из конфига").Равно("SuperApp");
	Ожидаем.Что(ДТО.Версия, "Версия должна быть из конфига").Равно("2.0.0");
	Ожидаем.Что(ДТО.БазаДанных.ИмяБазы, "Вложенное ИмяБазы должно быть из конфига").Равно("prod_db");
	Ожидаем.Что(ДТО.БазаДанных.Подключение.Хост, "Глубоко вложенный Хост должен быть из конфига").Равно("prod-host");
	Ожидаем.Что(ДТО.БазаДанных.Подключение.Порт, "Глубоко вложенный Порт должен быть из конфига").Равно(5432);

	УдалитьФайлы(ВременныйФайл);

КонецПроцедуры

// Вложенный DTO - умолчания при отсутствии ключей во вложенной структуре
Процедура ТестДолжен_ПрименитьУмолчанияВоВложенномДТО() Экспорт

	// Arrange
	ДТО = ЗагрузитьДТО("ТестовыйДТОБазаДанных.os");
	ВременныйФайл = ПолучитьВременныйФайлJSON(
		"{""БД"": {""ИмяБазы"": ""custom_db""}}"
	);

	Менеджер = Новый МенеджерПараметров;
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровJSON())
		.Настройки()
		.УстановитьФайлПараметров(ВременныйФайл);
	Менеджер.ЗарегистрироватьКлассПараметров(ДТО, "БД");

	// Act
	Менеджер.Прочитать();
	Менеджер.ЗаполнитьОбъектПараметров(ДТО);

	// Assert
	Ожидаем.Что(ДТО.ИмяБазы, "ИмяБазы должно быть из конфига").Равно("custom_db");
	Ожидаем.Что(ДТО.Подключение.Хост, "Вложенный Хост должен быть по умолчанию").Равно("localhost");
	Ожидаем.Что(ДТО.Подключение.Порт, "Вложенный Порт должен быть по умолчанию").Равно(5432);

	УдалитьФайлы(ВременныйФайл);

КонецПроцедуры

// Вложенный DTO создаётся по имени класса из параметра аннотации &ВложенныйДТО,
// когда свойство не инициализировано в конструкторе
Процедура ТестДолжен_СоздатьВложенныйДТОПоИмениКлассаИзАннотации() Экспорт

	// Arrange
	// имя класса, на которое ссылается аннотация в фикстуре, должно быть доступно для Новый()
	ПодключитьСценарий(ОбъединитьПути(КаталогФикстур, "ТестовоеПодключение.os"), "ТестовоеПодключениеКласс");

	ДТО = ЗагрузитьДТО("ТестовыйДТОБазаДанныхАннотация.os");
	Ожидаем.Что(ДТО.Подключение, "До регистрации вложенный объект не создан").Равно(Неопределено);

	ВременныйФайл = ПолучитьВременныйФайлJSON(
		"{""БД"": {""ИмяБазы"": ""test_db"", ""Подключение"": {""Хост"": ""db-server"", ""Порт"": 3306}}}"
	);

	Менеджер = Новый МенеджерПараметров;
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровJSON())
		.Настройки()
		.УстановитьФайлПараметров(ВременныйФайл);

	// Act
	Менеджер.ЗарегистрироватьКлассПараметров(ДТО, "БД");

	// Assert: объект создан описателем по имени класса из аннотации
	Ожидаем.Что(Строка(ТипЗнч(ДТО.Подключение)), "Вложенный объект создан по имени класса из аннотации")
		.Равно("ТестовоеПодключениеКласс");

	Менеджер.Прочитать();
	Менеджер.ЗаполнитьОбъектПараметров(ДТО);

	Ожидаем.Что(ДТО.ИмяБазы, "ИмяБазы должно быть из конфига").Равно("test_db");
	Ожидаем.Что(ДТО.Подключение.Хост, "Вложенный Хост должен быть заполнен из конфига").Равно("db-server");
	Ожидаем.Что(ДТО.Подключение.Порт, "Вложенный Порт должен быть заполнен из конфига").Равно(3306);

	УдалитьФайлы(ВременныйФайл);

КонецПроцедуры

// Заполняется тот экземпляр вложенного DTO, который лежит в свойстве
// на момент заполнения, а не тот, что был там при регистрации
Процедура ТестДолжен_ЗаполнитьВложенныйДТОПереприсвоенныйПослеРегистрации() Экспорт

	// Arrange
	ДТО = ЗагрузитьДТО("ТестовыйДТОБазаДанных.os");
	ВременныйФайл = ПолучитьВременныйФайлJSON(
		"{""БД"": {""ИмяБазы"": ""test_db"", ""Подключение"": {""Хост"": ""db-server"", ""Порт"": 3306}}}"
	);

	Менеджер = Новый МенеджерПараметров;
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровJSON())
		.Настройки()
		.УстановитьФайлПараметров(ВременныйФайл);
	Менеджер.ЗарегистрироватьКлассПараметров(ДТО, "БД");

	// Act: подменяем вложенный объект уже после регистрации
	НовоеПодключение = ЗагрузитьДТО("ТестовоеПодключение.os");
	ДТО.Подключение = НовоеПодключение;

	Менеджер.Прочитать();
	Менеджер.ЗаполнитьОбъектПараметров(ДТО);

	// Assert: заполнен новый экземпляр, а не захваченный при регистрации
	Ожидаем.Что(НовоеПодключение.Хост, "Заполнен должен быть текущий экземпляр вложенного DTO").Равно("db-server");
	Ожидаем.Что(НовоеПодключение.Порт, "Заполнен должен быть текущий экземпляр вложенного DTO").Равно(3306);

	УдалитьФайлы(ВременныйФайл);

КонецПроцедуры

// Регистрация падает, если поле помечено как вложенный DTO,
// но объекта нет и класс в аннотации не указан
Процедура ТестДолжен_ВыброситьИсключениеЕслиВложенныйДТОНеИнициализирован() Экспорт

	ДТО = ЗагрузитьДТО("ТестовыйДТОСНеинициализированнымВложенным.os");

	ВременныйФайл = ПолучитьВременныйФайлJSON(
		"{""БД"": {""ИмяБазы"": ""test_db"", ""Подключение"": {""Хост"": ""h"", ""Порт"": 1}}}"
	);

	Менеджер = Новый МенеджерПараметров;
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровJSON())
		.Настройки()
		.УстановитьФайлПараметров(ВременныйФайл);

	Попытка
		Менеджер.ЗарегистрироватьКлассПараметров(ДТО, "БД");
		Ожидаем.Что(Ложь, "Ожидалось исключение при описании неинициализированного вложенного DTO").Равно(Истина);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Подключение");
	КонецПопытки;

	УдалитьФайлы(ВременныйФайл);

КонецПроцедуры

// DTO с массивом во вложенной структуре
Процедура ТестДолжен_ОбработатьМассивВоВложенномДТО() Экспорт

	// Arrange
	ДТО = ЗагрузитьДТО("ТестовыйДТОСМассивом.os");
	ВременныйФайл = ПолучитьВременныйФайлJSON(
		"{""Кластер"": {""Имя"": ""prod-cluster"", ""Узлы"": [""node1"", ""node2"", ""node3""]}}"
	);

	Менеджер = Новый МенеджерПараметров;
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровJSON())
		.Настройки()
		.УстановитьФайлПараметров(ВременныйФайл);
	Менеджер.ЗарегистрироватьКлассПараметров(ДТО, "Кластер");

	// Act
	Менеджер.Прочитать();
	Менеджер.ЗаполнитьОбъектПараметров(ДТО);

	// Assert
	Ожидаем.Что(ДТО.Имя, "Имя кластера должно быть из конфига").Равно("prod-cluster");
	Ожидаем.Что(ДТО.Узлы.Количество(), "Должно быть 3 узла").Равно(3);
	Ожидаем.Что(ДТО.Узлы[0], "Первый узел").Равно("node1");
	Ожидаем.Что(ДТО.Узлы[1], "Второй узел").Равно("node2");
	Ожидаем.Что(ДТО.Узлы[2], "Третий узел").Равно("node3");

	УдалитьФайлы(ВременныйФайл);

КонецПроцедуры

