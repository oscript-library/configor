		"{""cfg"": {""Порт"": 8080, ""Включен"": true, ""Название"": ""test"", ""ДатаЗапуска"": ""2025-01-01T00:00:00""}}"
	);

	Менеджер = Новый МенеджерПараметров;
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровJSON())
		.Настройки()
		.УстановитьФайлПараметров(ВременныйФайл);
	Менеджер.ЗарегистрироватьКлассПараметров(ДТО, "cfg");
	Менеджер.Прочитать();
	Менеджер.ЗаполнитьОбъектПараметров(ДТО);

	Ожидаем.Что(ТипЗнч(ДТО.Порт), "Порт должен остаться числом").Равно(Тип("Число"));
	Ожидаем.Что(ДТО.Порт, "Порт должен быть 8080").Равно(8080);
	Ожидаем.Что(ТипЗнч(ДТО.Включен), "Включен должен остаться булево").Равно(Тип("Булево"));
	Ожидаем.Что(ДТО.Включен, "Включен должен быть true").Равно(Истина);

	УдалитьФайлы(ВременныйФайл);

КонецПроцедуры

// Два разных класса не могут занять один префикс:
// какой из них выиграл бы при заполнении, определить нельзя
Процедура ТестДолжен_ВыброситьИсключениеПриЗанятомПрефиксе() Экспорт

	ПервыйДТО = ЗагрузитьДТО("ТестовыйДТО.os");
	ВторойДТО = ЗагрузитьДТО("ТестовыйДТОССинонимом.os");

	Менеджер = Новый МенеджерПараметров;
	Менеджер.ЗарегистрироватьКлассПараметров(ПервыйДТО, "Префикс");

	Попытка
		Менеджер.ЗарегистрироватьКлассПараметров(ВторойДТО, "Префикс");
		Ожидаем.Что(Ложь, "Ожидалось исключение при регистрации на занятый префикс").Равно(Истина);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Префикс");
	КонецПопытки;

КонецПроцедуры

// Индекс параметров регистронезависим, поэтому префиксы,
// отличающиеся только регистром, считаются одним и тем же
Процедура ТестДолжен_СчитатьПрефиксыЗанятымиБезУчетаРегистра() Экспорт

	ПервыйДТО = ЗагрузитьДТО("ТестовыйДТО.os");
	ВторойДТО = ЗагрузитьДТО("ТестовыйДТОССинонимом.os");

	Менеджер = Новый МенеджерПараметров;
	Менеджер.ЗарегистрироватьКлассПараметров(ПервыйДТО, "Префикс");

	Попытка
		Менеджер.ЗарегистрироватьКлассПараметров(ВторойДТО, "ПРЕФИКС");
		Ожидаем.Что(Ложь, "Ожидалось исключение для префикса, отличающегося регистром").Равно(Истина);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("ПРЕФИКС");
	КонецПопытки;

КонецПроцедуры

// Повторная регистрация того же объекта заменяет прежнюю запись,
// заполнение идёт по префиксу из последней регистрации
Процедура ТестДолжен_ЗаменитьПрефиксПриПовторнойРегистрацииТогоЖеОбъекта() Экспорт

	ДТО = ЗагрузитьДТО("ТестовыйДТО.os");

	ВременныйФайл = ПолучитьВременныйФайлJSON(
		"{""Старый"": {""АдресСервера"": ""old-server""}, ""Новый"": {""АдресСервера"": ""new-server""}}"
	);

	Менеджер = Новый МенеджерПараметров;
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровJSON())
		.Настройки()
		.УстановитьФайлПараметров(ВременныйФайл);

	Менеджер.ЗарегистрироватьКлассПараметров(ДТО, "Старый");
	Менеджер.ЗарегистрироватьКлассПараметров(ДТО, "Новый");
	Менеджер.Прочитать();
	Менеджер.ЗаполнитьОбъектПараметров(ДТО);

	Ожидаем.Что(ДТО.АдресСервера, "Заполнение должно идти по префиксу последней регистрации").Равно("new-server");

	УдалитьФайлы(ВременныйФайл);

КонецПроцедуры

// Заполнение возможно только для зарегистрированного класса
Процедура ТестДолжен_ВыброситьИсключениеПриЗаполненииНезарегистрированногоКласса() Экспорт

	ДТО = ЗагрузитьДТО("ТестовыйДТО.os");

	Менеджер = Новый МенеджерПараметров;

	Попытка
		Менеджер.ЗаполнитьОбъектПараметров(ДТО);
		Ожидаем.Что(Ложь, "Ожидалось исключение для незарегистрированного класса").Равно(Истина);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("ЗарегистрироватьКлассПараметров");
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьВременныйФайлJSON(Знач СодержимоеJSON)

	ВременныйФайл = ПолучитьИмяВременногоФайла("json");
	ЗаписьТекста = Новый ЗаписьТекста(ВременныйФайл, "UTF-8");
	ЗаписьТекста.Записать(СодержимоеJSON);
	ЗаписьТекста.Закрыть();
	Возврат ВременныйФайл;

КонецФункции
