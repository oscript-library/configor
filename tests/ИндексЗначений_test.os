#использовать "../src/"
#Использовать asserts

Перем КоличествоКлючей; // Число - количество параметров в тестовом источнике
Перем КоличествоЗаданий; // Число - количество параллельных фоновых заданий
Перем КоличествоЧтений; // Число - количество вызовов Параметр() в каждом задании
Перем КоличествоПеречитываний; // Число - количество вызовов Прочитать() во время параллельного чтения

&Тест
Процедура ТестДолжен_ПостроитьИндексОдинРазДляКоллекции() Экспорт

	// Дано
	Индекс = Новый ИндексЗначений;
	Индекс.Коллекция(ТестовыеПараметры());

	// Когда
	ПервыйИндекс = Индекс.ПолучитьИндекс();
	Индекс.Значение("key1.value");
	ВторойИндекс = Индекс.ПолучитьИндекс();

	Индекс.Коллекция(ТестовыеПараметры());
	ИндексНовойКоллекции = Индекс.ПолучитьИндекс();

	// Тогда
	Ожидаем.Что(ПервыйИндекс = ВторойИндекс, "Повторное чтение не должно пересобирать индекс").ЭтоИстина();
	Ожидаем.Что(ИндексНовойКоллекции = ПервыйИндекс, "Новая коллекция должна дать новый индекс").ЭтоЛожь();
	Ожидаем.Что(Индекс.Значение("KEY1.Value")).Равно("значение1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПерестроитьИндексМенеджераПослеПрочитать() Экспорт

	// Дано
	МенеджерПараметров = НовыйМенеджерПараметров();
	ИндексПараметров = Новый Рефлектор().ПолучитьСвойство(МенеджерПараметров, "ИндексПараметров");

	// Когда
	ПервыйИндекс = ИндексПараметров.ПолучитьИндекс();
	МенеджерПараметров.Параметр("key1.value");
	ВторойИндекс = ИндексПараметров.ПолучитьИндекс();

	МенеджерПараметров.Прочитать();
	ИндексПослеПрочитать = ИндексПараметров.ПолучитьИндекс();

	// Тогда
	Ожидаем.Что(ПервыйИндекс = ВторойИндекс, "Параметр() не должен пересобирать индекс").ЭтоИстина();
	Ожидаем.Что(ИндексПослеПрочитать = ПервыйИндекс, "Прочитать() должен построить новый индекс").ЭтоЛожь();
	Ожидаем.Что(МенеджерПараметров.Параметр("key1.value")).Равно("значение1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьИсключениеПослеОчисткиИндекса() Экспорт

	// Дано
	Индекс = Новый ИндексЗначений;
	Индекс.Коллекция(ТестовыеПараметры());

	// Когда
	Индекс.Очистить();

	// Тогда
	БылоИсключение = Ложь;
	Попытка
		Индекс.Значение("key1.value");
	Исключение
		БылоИсключение = Истина;
		Ожидаем.Что(ИнформацияОбОшибке().Описание).Содержит("Коллекция индекса не установлена");
	КонецПопытки;

	Ожидаем.Что(БылоИсключение, "После очистки индекс недоступен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПараллельноЧитатьПараметрыБезОшибок() Экспорт

	// Дано
	МенеджерПараметров = НовыйМенеджерПараметров();

	// Когда
	Задания = Новый Массив;
	Для НомерЗадания = 1 По КоличествоЗаданий Цикл
		Задания.Добавить(ЗапуститьЧтениеПараметров(МенеджерПараметров, НомерЗадания));
	КонецЦикла;

	// Тогда
	ПроверитьОтсутствиеОшибок(Задания);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЧитатьПараметрыПараллельноСПрочитать() Экспорт

	// Дано
	МенеджерПараметров = НовыйМенеджерПараметров();

	// Когда
	Задания = Новый Массив;
	Для НомерЗадания = 1 По КоличествоЗаданий Цикл
		Задания.Добавить(ЗапуститьЧтениеПараметров(МенеджерПараметров, НомерЗадания));
	КонецЦикла;

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(МенеджерПараметров);
	Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПеречитыватьПараметры", ПараметрыЗадания, Истина));

	// Тогда
	ПроверитьОтсутствиеОшибок(Задания);

КонецПроцедуры

#Область Фоновые_задания

Процедура ЧитатьПараметры(Знач МенеджерПараметров, Знач НомерЗадания) Экспорт

	Ошибки = Новый Массив;

	Для НомерЧтения = 1 По КоличествоЧтений Цикл

		НомерКлюча = (НомерЗадания + НомерЧтения) % КоличествоКлючей + 1;
		ИмяПараметра = СтрШаблон("key%1.value", НомерКлюча);
		ОжидаемоеЗначение = СтрШаблон("значение%1", НомерКлюча);

		Попытка
			Значение = МенеджерПараметров.Параметр(ИмяПараметра);
		Исключение
			Ошибки.Добавить(СтрШаблон("%1: %2", ИмяПараметра, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Продолжить;
		КонецПопытки;

		Если Значение <> ОжидаемоеЗначение Тогда
			Ошибки.Добавить(СтрШаблон("%1: ожидалось <%2>, получено <%3>", ИмяПараметра, ОжидаемоеЗначение, Значение));
		КонецЕсли;

	КонецЦикла;

	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон("Ошибок чтения %1 из %2, первая: %3",
			Ошибки.Количество(), КоличествоЧтений, Ошибки[0]);
	КонецЕсли;

КонецПроцедуры

Процедура ПеречитыватьПараметры(Знач МенеджерПараметров) Экспорт

	Для НомерЧтения = 1 По КоличествоПеречитываний Цикл
		МенеджерПараметров.Прочитать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Вспомогательные_процедуры_и_функции

Функция ЗапуститьЧтениеПараметров(МенеджерПараметров, НомерЗадания)

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(МенеджерПараметров);
	ПараметрыЗадания.Добавить(НомерЗадания);

	Возврат ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЧитатьПараметры", ПараметрыЗадания, Истина);

КонецФункции

Процедура ПроверитьОтсутствиеОшибок(Задания)

	Ошибки = Новый Массив;

	Для Каждого Задание Из Задания Цикл

		Если НЕ Задание.ОжидатьЗавершения(60000) Тогда
			ВызватьИсключение "Фоновое задание не завершилось за 60 секунд";
		КонецЕсли;

		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			Ошибки.Добавить(КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(Ошибки.Количество(),
		СтрШаблон("Заданий с ошибками %1 из %2:%3%4", Ошибки.Количество(), Задания.Количество(),
			Символы.ПС, СтрСоединить(Ошибки, Символы.ПС))).Равно(0);

КонецПроцедуры

Функция НовыйМенеджерПараметров()

	МенеджерПараметров = Новый МенеджерПараметров();
	МенеджерПараметров.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(ТестовыеПараметры()));
	МенеджерПараметров.Прочитать();

	Возврат МенеджерПараметров;

КонецФункции

Функция ТестовыеПараметры()

	Параметры = Новый Соответствие;

	Для НомерКлюча = 1 По КоличествоКлючей Цикл

		ВложенныеПараметры = Новый Соответствие;
		ВложенныеПараметры.Вставить("value", СтрШаблон("значение%1", НомерКлюча));

		Параметры.Вставить(СтрШаблон("key%1", НомерКлюча), ВложенныеПараметры);

	КонецЦикла;

	Возврат Параметры;

КонецФункции

#КонецОбласти

КоличествоКлючей = 50;
КоличествоЗаданий = 32;
КоличествоЧтений = 200;
КоличествоПеречитываний = 50;
